<%- include('partials/header.ejs') %>
<%- include('partials/main.nav.ejs') %>

<main class="container mt-5">
  <h1>Contact Me</h1>

  <p>
    Have a question or want to get in touch?
    Feel free to contact me!
  </p>

  <form>
    <div class="mb-3">
      <label for="name" class="form-label">Name</label>
      <input type="text" class="form-control"
             id="name" name="name" required>
    </div>

    <div class="mb-3">
      <label for="email" class="form-label">Email</label>
      <input type="email" class="form-control"
             id="email" name="email" required>
    </div>

    <div class="mb-3">
      <label for="tel" class="form-label">Cell No.</label>
      <input type="tel" class="form-control"
             id="tel" name="tel">
    </div>

    <div class="mb-3">
      <label for="contactMethod" class="form-label">
        How would you like to be contacted?
      </label>
      <select class="form-select" id="contactMethod" name="contactMethod">
        <option value="">Select an option</option>
        <option value="email">Email</option>
        <option value="phone">Phone Call</option>
        <option value="text">Text Message</option>
      </select>
    </div>

    <div class="mb-3">
      <label for="referralSource" class="form-label">
        How did you hear about me?
      </label>
      <select class="form-select" id="referralSource" name="referralSource">
        <option value="">Select an option</option>
        <option value="linkedin">LinkedIn</option>
        <option value="github">GitHub</option>
        <option value="university">Ontario Tech University</option>
        <option value="referral">Friend or Referral</option>
        <option value="other">Other</option>
      </select>
    </div>

    <div class="mb-3">
      <label for="comments" class="form-label">Comments</label>
      <textarea class="form-control"
                id="comments" name="comments"
                rows="4"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
      Submit
    </button>
  </form>
</main>

<%- include('partials/footer.ejs') %>
